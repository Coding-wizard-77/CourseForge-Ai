PORT=8080
CLIENT_ORIGIN=http://localhost:3000

# Optional: enables real Gemini generation. Without this, deterministic demo agents are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ADVANCED_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_API_VERSION=v1beta
GEMINI_TIMEOUT_MS=30000

# Optional: enables live YouTube search. Without this, curated demo resources are generated.
YOUTUBE_API_KEY=

# Optional: PostgreSQL persistence. Without this, in-memory persistence is used.
DATABASE_URL=

# Authentication
JWT_ACCESS_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=

# Optional: Google OAuth sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Optional: Pinecone vector storage. Without this, local JSON vector storage is used.
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=courseforge
